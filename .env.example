# Copie para .env.local (web) e .env (worker). Nunca commite os arquivos reais.

# Ambiente da aplicação (separado do NODE_ENV, que o `next start` força para production)
APP_ENV=development                     # development | test | staging | production

# Banco
DATABASE_URL=postgres://app:app@localhost:5432/plataforma      # papel da aplicação (sem BYPASSRLS)
DATABASE_MIGRATOR_URL=postgres://owner:owner@localhost:5432/plataforma  # só para migrações

# Autenticação
BETTER_AUTH_SECRET=                     # segredo da aplicação (mínimo 32 caracteres)
BETTER_AUTH_URL=http://app.localhost:3000
AUTH_EMAIL_FROM=                        # remetente do link mágico e dos convites
APP_BASE_DOMAIN=localhost:3000          # painel: app.APP_BASE_DOMAIN; portal: <slug>.APP_BASE_DOMAIN

# Armazenamento S3: Cloudflare R2 em produção; SeaweedFS do docker compose em dev
# (credenciais fictícias de infra/seaweedfs/s3.json)
STORAGE_ENDPOINT=http://localhost:8333        # R2: https://<conta>.r2.cloudflarestorage.com
STORAGE_BUCKET=documentos                     # bucket privado
STORAGE_ACCESS_KEY_ID=dev-storage-key
STORAGE_SECRET_ACCESS_KEY=dev-storage-secret-nao-real
STORAGE_REGION=auto

# Criptografia de certificados e credenciais (AWS KMS em produção)
CRYPTO_PROVIDER=local                   # local (dev, testes, CI) | aws-kms (staging, produção)
CRYPTO_LOCAL_KEY=                       # só com CRYPTO_PROVIDER=local; 32 bytes em base64
KMS_KEY_ID=
KMS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=                      # usuário IAM com permissão só para Encrypt/Decrypt nessa chave
AWS_SECRET_ACCESS_KEY=

# Tempo real
ABLY_API_KEY=

# WhatsApp Cloud API (app da plataforma; tokens por tenant ficam cifrados no banco)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# E-mail
EMAIL_PROVIDER=smtp                     # smtp (Mailpit local) | resend
SMTP_URL=smtp://localhost:1025
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Serpro (incremento 4). As credenciais do modo próprio ficam cifradas no banco, por escritório.
SERPRO_PROVIDER=fake                    # fake (respostas gravadas) | trial (ambiente de testes da Serpro) | producao
SERPRO_CONTRATANTE_CNPJ=11222333000181  # CNPJ do contrato da plataforma (modo plataforma)
# Só com producao: contrato e e-CNPJ da plataforma, cifrados (pnpm serpro:cifrar).
SERPRO_CONSUMER_KEY_CIPHERTEXT=
SERPRO_CONSUMER_SECRET_CIPHERTEXT=
SERPRO_CERT_PFX_CIPHERTEXT=
SERPRO_CERT_PASSWORD_CIPHERTEXT=

# Observabilidade
SENTRY_DSN=
LOG_LEVEL=info

# Copie para .env.local (web) e .env (worker). Nunca commite os arquivos reais.

# Banco
DATABASE_URL=postgres://app:app@localhost:5432/plataforma      # papel da aplicação (sem BYPASSRLS)
DATABASE_MIGRATOR_URL=postgres://owner:owner@localhost:5432/plataforma  # só para migrações

# Autenticação
AUTH_SECRET=
AUTH_EMAIL_FROM=                        # remetente do link mágico (Resend)
MFA_ENCRYPTION_KEY_ID=                  # chave KMS que cifra os segredos TOTP
APP_BASE_DOMAIN=localhost:3000          # painel: app.APP_BASE_DOMAIN; portal: <slug>.APP_BASE_DOMAIN

# Armazenamento (Cloudflare R2 / S3)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Criptografia de certificados e credenciais (KMS)
KMS_KEY_ID=
KMS_REGION=

# Tempo real
ABLY_API_KEY=

# WhatsApp Cloud API (app da plataforma; tokens por tenant ficam cifrados no banco)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# E-mail
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Serpro (credenciais por tenant ficam cifradas no banco; aqui só o ambiente)
SERPRO_ENV=trial                        # trial | production

# Observabilidade
SENTRY_DSN=
LOG_LEVEL=info

{
  "name": "@contab/worker",
  "private": true,
  "type": "module",
  "exports": {
    "./define-job": "./src/define-job.ts",
    "./jobs": "./src/jobs/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "tenant:create": "tsx --env-file-if-exists=../../.env src/cli/tenant-create.ts",
    "storage:setup": "tsx --env-file-if-exists=../../.env src/cli/storage-setup.ts",
    "portal:dev-login": "tsx --env-file-if-exists=../../.env src/cli/portal-dev-login.ts"
  },
  "dependencies": {
    "@contab/adapters": "workspace:*",
    "@contab/config": "workspace:*",
    "@contab/core": "workspace:*",
    "@contab/db": "workspace:*",
    "@contab/domain": "workspace:*",
    "pg-boss": "12.38.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
